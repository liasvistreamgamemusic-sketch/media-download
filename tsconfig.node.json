{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "core-alias.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@liasvistreamgamemusic-sketch/media-dl": [
        "packages/core/src/index.ts"
      ],
      "@liasvistreamgamemusic-sketch/media-dl/*": [
        "packages/core/src/*"
      ]
    }
  }
}
